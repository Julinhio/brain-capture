# Local development. Copy to .env (gitignored). Production values live in Railway variables.

# PGlite folder for local dev; Railway injects a postgres:// URL in production.
DATABASE_URL=pglite:.data/pglite

# The only account. Hash produced by: echo <password> | npx tsx scripts/hash-password.ts
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Optional: a file outside the repo holding GROQ_API_KEY, loaded by `npm run dev`.
DEV_SECRETS_FILE=

# Dashboard sources. Tokens only allow aggregate reads, never reuse radar login secrets.
RADAR_JOBS_URL=https://radar-web-production-0f54.up.railway.app
RADAR_JOBS_TOKEN=
RADAR_AUTOMATA_URL=https://agence-site-production.up.railway.app/radar
RADAR_AUTOMATA_TOKEN=

# Set all four together to enable Google Calendar (read-only, calendar discovery + events).
# Generate CALENDAR_ENCRYPTION_KEY as 32 random bytes, hex encoded; keep it across redeploys.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_ENCRYPTION_KEY=
# Calendars are discovered automatically; legacy GOOGLE_CALENDAR_ID is ignored.

# Overrides, rarely needed.
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b

# The Vite dev proxy forwards to :3000, so its origin must be allowed explicitly.
ALLOWED_ORIGINS=http://localhost:5173
